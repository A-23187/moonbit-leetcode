{
    "manifest_version": 3,
    "name": "MoonBit LeetCode",
    "version": "1.1.0",
    "description": "add support of moonbit language to leetcode",
    "homepage_url": "https://github.com/A-23187/moonbit-leetcode",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "host_permissions": [
        "https://leetcode.cn/*",
        "https://leetcode.com/*"
    ],
    "content_scripts": [
        {
            "js": [
                "loader.js"
            ],
            "matches": [
                "https://leetcode.cn/problems/*",
                "https://leetcode.com/problems/*"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "index.js",
                "moonpad-monaco/*.js",
                "moonpad-monaco/onig.wasm"
            ],
            "matches": [
                "https://leetcode.cn/*",
                "https://leetcode.com/*"
            ]
        }
    ]
}
